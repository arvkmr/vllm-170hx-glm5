[Unit]
Description=Cap the SM clock of one marginal GPU (silent-fault mitigation)
Wants=nvidia-persistenced.service
After=nvidia-persistenced.service

# Some CMP 170HX cards compute silently wrong results under the heaviest
# inference kernels at their default clock (no ECC, no Xid): an all-zero MoE
# output row surfaces as a stray token with logprob -ln(vocab) = -11.95, and
# occasionally as garbage top-k indices. Locate the card with probe_bang.py
# (plus a CUDA_VISIBLE_DEVICES swap: the fault follows the card), then cap it.
# 1300 MHz removed the fault completely on the affected card at no measurable
# decode cost (one stage of a 10-stage pipeline).
#
# Install:
#   sudo cp gpu-clock-cap.service /etc/systemd/system/
#   printf 'GPU_BUS_ID=00000000:XX:00.0\nMAX_SM_MHZ=1300\n' | sudo tee /etc/default/gpu-clock-cap
#   sudo systemctl daemon-reload && sudo systemctl enable --now gpu-clock-cap.service
# Remove only after the card is replaced or re-validated with probe_bang.py:
#   sudo systemctl disable --now gpu-clock-cap.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/default/gpu-clock-cap
ExecStartPre=/sbin/modprobe nvidia
ExecStart=/usr/bin/nvidia-smi -i ${GPU_BUS_ID} -lgc 210,${MAX_SM_MHZ}
ExecStop=/usr/bin/nvidia-smi -i ${GPU_BUS_ID} -rgc

[Install]
WantedBy=multi-user.target
